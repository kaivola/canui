{
  "openapi": "3.1.0",
  "info": { "title": "FastAPI", "version": "0.1.0" },
  "paths": {
    "/status": {
      "get": {
        "tags": ["status"],
        "summary": "Get Status",
        "operationId": "get_status_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusDto" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["status"],
        "summary": "Update Status",
        "operationId": "update_status_status_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Status" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusDto" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/messages/dbc-files": {
      "get": {
        "tags": ["messages"],
        "summary": "Get Dbc Files",
        "operationId": "get_dbc_files_messages_dbc_files_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "type": "string" },
                  "type": "array",
                  "title": "Response Get Dbc Files Messages Dbc Files Get"
                }
              }
            }
          }
        }
      }
    },
    "/messages/dbc-files/{filename}": {
      "post": {
        "tags": ["messages"],
        "summary": "Select Dbc File",
        "operationId": "select_dbc_file_messages_dbc_files__filename__post",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "title": "Filename" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MessageDto" },
                  "title": "Response Select Dbc File Messages Dbc Files  Filename  Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/messages/{message_id}/enable": {
      "post": {
        "tags": ["messages"],
        "summary": "Enable Message",
        "operationId": "enable_message_messages__message_id__enable_post",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Message Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/messages/{message_id}/disable": {
      "post": {
        "tags": ["messages"],
        "summary": "Disable Message",
        "operationId": "disable_message_messages__message_id__disable_post",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "title": "Message Id" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageDto": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "signals": {
            "items": { "$ref": "#/components/schemas/SignalDto" },
            "type": "array",
            "title": "Signals"
          }
        },
        "type": "object",
        "required": ["id", "signals"],
        "title": "MessageDto"
      },
      "SignalDto": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "comment": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Comment"
          },
          "length": { "type": "integer", "title": "Length" },
          "minValue": {
            "anyOf": [
              { "type": "integer" },
              { "type": "number" },
              { "type": "null" }
            ],
            "title": "Minvalue"
          },
          "maxValue": {
            "anyOf": [
              { "type": "integer" },
              { "type": "number" },
              { "type": "null" }
            ],
            "title": "Maxvalue"
          },
          "displayName": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Displayname"
          },
          "nominalMin": {
            "anyOf": [
              { "type": "integer" },
              { "type": "number" },
              { "type": "null" }
            ],
            "title": "Nominalmin"
          },
          "nominalMax": {
            "anyOf": [
              { "type": "integer" },
              { "type": "number" },
              { "type": "null" }
            ],
            "title": "Nominalmax"
          },
          "step": { "type": "number", "title": "Step", "default": 1.0 },
          "value": {
            "anyOf": [{ "type": "integer" }, { "type": "number" }],
            "title": "Value",
            "default": 0
          }
        },
        "type": "object",
        "required": ["name", "comment", "length", "minValue", "maxValue"],
        "title": "SignalDto"
      },
      "Status": {
        "properties": {
          "status": { "$ref": "#/components/schemas/StatusOptions" }
        },
        "type": "object",
        "required": ["status"],
        "title": "Status"
      },
      "StatusDto": {
        "properties": {
          "isBroadcasting": { "type": "boolean", "title": "Isbroadcasting" }
        },
        "type": "object",
        "required": ["isBroadcasting"],
        "title": "StatusDto"
      },
      "StatusOptions": {
        "type": "string",
        "enum": ["start", "stop"],
        "title": "StatusOptions"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
